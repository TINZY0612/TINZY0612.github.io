[{"sha":"2d4dd77f27eac54cd2775e8a9985f2670090d6c7","node_id":"C_kwDOIE6rP9oAKDJkNGRkNzdmMjdlYWM1NGNkMjc3NWU4YTk5ODVmMjY3MDA5MGQ2Yzc","commit":{"author":{"name":"gomes","email":"17035424+gomesalexandre@users.noreply.github.com","date":"2026-11-17T09:55:36Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-11-17T09:55:36Z"},"message":"[fix] circle usyc - read fees on-chain, the api only serves the last 45 reports (#11097)\n\n* fix: circle usyc - read fees from the price reporter events\n\nThe price-reports API only serves the last 45 reports, so older days\nreturned 0 and a refill would zero stored history. Read the Transmitted\nevents (both versions) on the USYC PriceReporterProxy instead, throw\nbefore USYC's first on-chain report (2024-08-28), and split the gross\nyield into the performance fee (minted as USYC, valued at the report\nprice) and the holders' share.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n* query historic numbers\n\n---------\n\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>\nCo-authored-by: bheluga <bheluga@defillama.com>","tree":{"sha":"ef143aa6900f9550d4980eb5c3212746a10f69d4","url":"https://api.github.com/repos/DefiLlama/dimension-adapters/git/trees/ef143aa6900f9550d4980eb5c3212746a10f69d4"},"url":"https://api.github.com/repos/DefiLlama/dimension-adapters/git/commits/2d4dd77f27eac54cd2775e8a9985f2670090d6c7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq/CSZCRC1aQ7uu5UhlAAAdQYQAJ3Ek9Ncatii4y5oCWaOUmGY\nDConxH9082wdusI7UsNPgqY6HSm85nee7WhTp+lkpgP6MPXfS2DmT4rxSPnH5E/j\njg54rYuhbmGKEI7jFiKoHqmTwk3+u448MhrNMoz8screYTfQtP7gVClL5ye7E6hA\nfgn+uhDv8CeDXHpqN6xN158JTW5eeP5WZaakerMXFaWPlsB47uEpIdOf4ELd1uIM\nlJ84ZlPZYDe2nrusK/kEHhsRIzajegrjan3fBEN/nXITxb2/z8eRD89Hs7nq6wQu\n2IZE8wKMeNePcCYfS6d7wMyPKIKbIxU4RTOy/j/AEBCpGp6HDfbhTUcpNR1s8Tcf\nO6Y0tZkhYSEj/iklT9KlqZW4dweWSWQx+rtahRbkHHvr9PTPMim7pQjUdtgeVFNG\nrc+8HwsP4BLujHTWHXpxJ3qmgQcmRqqf9mzRpmp0C/Eq9tRs8s8fkwpJqCL64Z42\nnw1iSDOoxO4zjQfU0t6PtzD64UmUsr5YEPqSYvo0oGkH5T5F2oe0D9TytxCcmpL1\nXE8N2DSnup8ZqlH3htK1Ucs88F+JxF+o4sluavGSyOGZuJR3i3vdlGw2LhiICQPK\nP9zp7sjW7FaHMQ9gj7JFnaqMcXckkbW7GtNglt5fLqArBQag2+VTe64PT0++4Chu\nvDRsxaoXaUqix9OUH4+j\n=lQQC\n-----END PGP SIGNATURE-----\n","payload":"tree ef143aa6900f9550d4980eb5c3212746a10f69d4\nparent d03c80ad6214c898fd3c2b03e432a949c94e92a9\nauthor gomes <17035424+gomesalexandre@users.noreply.github.com> 1794909336 +0400\ncommitter GitHub <noreply@github.com> 1794909336 +0000\n\n[fix] circle usyc - read fees on-chain, the api only serves the last 45 reports (#11097)\n\n* fix: circle usyc - read fees from the price reporter events\n\nThe price-reports API only serves the last 45 reports, so older days\nreturned 0 and a refill would zero stored history. Read the Transmitted\nevents (both versions) on the USYC PriceReporterProxy instead, throw\nbefore USYC's first on-chain report (2024-08-28), and split the gross\nyield into the performance fee (minted as USYC, valued at the report\nprice) and the holders' share.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n* query historic numbers\n\n---------\n\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>\nCo-authored-by: bheluga <bheluga@defillama.com>","verified_at":"2026-11-17T09:55:37Z"}},"url":"https://api.github.com/repos/DefiLlama/dimension-adapters/commits/2d4dd77f27eac54cd2775e8a9985f2670090d6c7","html_url":"https://github.com/DefiLlama/dimension-adapters/commit/2d4dd77f27eac54cd2775e8a9985f2670090d6c7","comments_url":"https://api.github.com/repos/DefiLlama/dimension-adapters/commits/2d4dd77f27eac54cd2775e8a9985f2670090d6c7/comments","author":{"login":"gomesalexandre","id":17035424,"node_id":"MDQ6VXNlcjE3MDM1NDI0","avatar_url":"https://avatars.githubusercontent.com/u/17035424?v=4","gravatar_id":"","url":"https://api.github.com/users/gomesalexandre","html_url":"https://github.com/gomesalexandre","followers_url":"https://api.github.co