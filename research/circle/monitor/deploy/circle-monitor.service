[Unit]
Description=Circle reserve-income forecast and validation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/circle-monitor
ExecStart=%h/circle-monitor/.venv/bin/python -m circle_monitor run --config %h/circle-monitor/config.json --state %h/circle-monitor/state --output %h/circle-monitor/export
ExecStartPost=%h/circle-monitor/.venv/bin/python -m circle_monitor publish --output %h/circle-monitor/export --checkout %h/circle-website --execute
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true

# INACTIVE TEMPLATE. Enable only after ~/circle-website is a tested main-branch
# checkout of the user's website with repository-scoped Git authentication.
# No AI is invoked. Remove ExecStartPost for a collection-only installation.
